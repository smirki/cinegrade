    "temperature": 0.0,
    "tint": 0.0,
    "contrast": 1.0,
    "saturation": 1.0,
    "vibrance": 0.0,
    "black_lift": 0.004,
    "highlight_rolloff": 0.06
  },
  "look": {
    "lut": "silverblue",
    "mix": 1.0
  },
  "fx": {
    "halation": {
      "enabled": false
    },
    "bloom": {
      "enabled": true,
      "threshold": 0.74,
      "sigma": 110,
      "strength": 0.2,
      "tint": [
        0.94,
        0.97,
