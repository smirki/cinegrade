{
  "_comment": "Flat, clean, brand-safe. Leaves headroom for titles and graphics. No vignette and no grain on purpose. Measured mean saturation 0.23 exterior / 0.16 interior.",
  "convert": {
    "working_space": "dwg",
    "tonemap": "aces",
    "encode": "rec709a",
    "exposure": 0.05
  },
  "primaries": {
    "temperature": 0.0,
    "tint": 0.0,
    "contrast": 1.0,
    "saturation": 1.0,
    "vibrance": 0.0,
    "black_lift": 0.0,
    "highlight_rolloff": 0.04
  },
  "look": {
    "lut": "commercial",
    "mix": 1.0
  },
  "fx": {
    "halation": {
      "enabled": true,
      "threshold": 0.8,
      "sigma": 16,
      "strength": 0.16,
      "tint": [
        1.0,
        0.4,
        0.2
      ]
    },
    "bloom": {
      "enabled": false
    },
    "rgb_split": {
      "enabled": false
    },
    "radial_blur": {
      "enabled": false
    },
    "vignette": {
      "enabled": false,
      "amount": 0.0
    }
  },
  "detail": {
    "soften": 0.0,
    "sharpen": 0.6
  },
  "grain": {
    "enabled": false
  },
  "letterbox": {
    "enabled": false,
    "aspect": 2.39
  }
}
