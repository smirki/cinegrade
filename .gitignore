# large or regenerable or user-owned data; the repo tracks code, presets, tests, docs
footage/
refs/
grade/out/
grade/luts/
grade/tests/_work/
studio/cache/
studio/data/
studio/tests/.cache/
.venv/
node_modules/
__pycache__/
*.pyc
.DS_Store
studio/shots/
grade/stills/

# captions: keep the reference stills (the bare "refs/" rule above would eat
# them), drop the cached stages and the rendered video
!captions/refs/
captions/work/
captions/out/
captions/omni-test/*.mp4

# grading bakeoff: sources, reference stills, agent runs and the throwaway server data
bakeoff/*
!bakeoff/*.md

# worktrees symlink these to the main tree; the slash rules above only match directories
.venv
footage
refs
studio/tests/node_modules
